{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keo Companion",
  "version": "0.1.0",
  "identifier": "ai.askkeo.companion",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "keo": {
      "baseUrl": "https://askkeo.ai"
    },
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://askkeo.ai/companion/latest.json",
        "https://github.com/upwage/keo-plugin/releases/download/companion-stable/latest.json"
      ]
    }
  }
}
